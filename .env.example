# Copy this file to .env and adjust as needed.
# Used by docker-compose for local infra; the backend also reads these
# (directly as env vars, or via backend/.env if you use something like
# direnv / a Spring dotenv plugin) - see backend/src/main/resources/application.yml.

# ---- Postgres ----
POSTGRES_DB=chatapp
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=chatapp
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=chatapp
MINIO_ROOT_PASSWORD=chatapp123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=chatapp-uploads

# ---- Backend ----
# Full JDBC URL the Spring Boot app connects with (host machine, not docker network)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chatapp
SPRING_DATASOURCE_USERNAME=chatapp
SPRING_DATASOURCE_PASSWORD=chatapp

SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# JWT signing secret - MUST be overridden with a long random value in any
# real deployment. Generate e.g. `openssl rand -base64 64`.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me-32bytes-min
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# S3 / MinIO client config used by the backend to generate presigned URLs
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=chatapp
S3_SECRET_KEY=chatapp123
S3_BUCKET=chatapp-uploads
# Public base URL used to build download links (MinIO served locally here)
S3_PUBLIC_URL=http://localhost:9000/chatapp-uploads

# Comma-separated list of origins allowed to call the API / open WS connections
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws
